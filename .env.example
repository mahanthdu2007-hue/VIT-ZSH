# System 2 LLM: auto (try Gemini, then NVIDIA, else none), gemini, nvidia or none
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=
# System 1 backend: nli (zero-shot model), keyword (offline), jev (commercial stub)
SYSTEM1_BACKEND=nli
SYSTEM1_MODEL=MoritzLaurer/deberta-v3-base-zeroshot-v2.0
DATABASE_URL=sqlite:///./prism.db
DEMO_MODE=0
