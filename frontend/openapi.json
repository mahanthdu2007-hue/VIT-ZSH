{
  "openapi": "3.1.0",
  "info": {
    "title": "PRISM Engine API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "system1": {
            "type": "string",
            "title": "System1"
          },
          "llm": {
            "type": "string",
            "enum": [
              "groq",
              "gemini",
              "none"
            ],
            "title": "Llm"
          },
          "demo_mode": {
            "type": "boolean",
            "title": "Demo Mode"
          }
        },
        "type": "object",
        "required": [
          "status",
          "system1",
          "llm",
          "demo_mode"
        ],
        "title": "HealthResponse"
      }
    }
  }
}
